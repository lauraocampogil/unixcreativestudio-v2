{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "unix-creative-studio",
	"compatibility_date": "2026-10-16",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Variables publiques du site en ligne (les secrets, eux, se mettent dans Cloudflare : Settings → Variables and Secrets)
	"vars": {
		"PUBLIC_DIRECTUS_URL": "http://directus-fuivg7lj906mgs14ueptnqgd.128.140.85.57.sslip.io",
		"RESEND_FROM": "Unix Creative Studio <hello@unixcreativestudio.com>"
	},
	// Garde les variables ajoutées dans le tableau de bord Cloudflare lors des déploiements
	"keep_vars": true,
	"workers_dev": true,
	"preview_urls": true
}
